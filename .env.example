# 10-frontend-nextjs.md §C. All three MUST be prefixed NEXT_PUBLIC_ since browser code reads them.

# MapTiler's client-side SDK key. Meant to be public; restrict by HTTP referrer on MapTiler's
# own dashboard rather than trying to hide it.
NEXT_PUBLIC_MAPTILER_API_KEY=

# The 08-public-api-service.md REST base, e.g. http://localhost:8000 for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Same service, WebSocket base, e.g. ws://localhost:8000 for local development.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
